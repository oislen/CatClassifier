# ignore sub repos
data/*
.creds
checkpoints

# allow specific pytorch model files
!data/models/AlexNet8_pretrained.pt
!data/models/ResNet50_pretrained.pt
!data/models/VGG16_pretrained.pt

# python cache
__pycache__
*.pyc

#ipynob checkoukpoints
.ipynb_checkpoints

# quarto tmp files
*.css
*.woff
*.js
*.html

# repo file types
*.pt
*.keras
*.pickle
*.csv

# allow specific torch files from model sub-directory
!data/models/*.pt