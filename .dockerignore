# ignore sub repos
.creds
checkpoints
.venv

# allow specific data model files
data/*
!data/models/

# python cache
__pycache__
*.pyc

#ipynob checkoukpoints
.ipynb_checkpoints

# quarto tmp files
*.css
*.woff
*.js
*.html

# repo file types
**/*.keras
**/*.pickle
**/*.csv

# allow specific torch files from model sub-directory
**/*.pt
!data/models/*.pt