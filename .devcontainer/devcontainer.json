{
  "name": "Cat Classifier",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--name", "cc",
    "--gpus", "all",
    "--env", "PARAM_CHECK_GPU=True",
    "--volume", "E:\\GitHub\\CatClassifier\\.creds:/home/ubuntu/CatClassifier/.creds",
    "--volume", "E:\\GitHub\\CatClassifier\\report:/home/ubuntu/CatClassifier/report"
  ],
  "postStartCommand": "uv run flask --app api.py run",
  "forwardPorts": [5000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "ms-vscode.makefile-tools",
        "mechatroner.rainbow-csv",
        "charliermarsh.ruff",
        "eamodio.gitlens",
        "quarto.quarto"
      ],
      "settings": {
        "python.languageServer": "Pylance",
        "editor.formatOnSave": true,
        "[python]": {
            "editor.defaultFormatter": "charliermarsh.ruff",
            "editor.formatOnSave": true,
            "editor.codeActionsOnSave": {
                "source.organizeImports": "explicit"
          }
        },
        "ruff.fixAll": true,
        "python.defaultInterpreterPath": "/home/user/CatClassifier/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "uv tool install ruff"
}